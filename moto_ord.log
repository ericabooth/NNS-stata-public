. webuse motorcycle, clear
(Motorcycle data from Fan & Gijbels (1996))

. foreach o in 2 3 4 {
  2.     foreach m in connect ols {
  3.         quietly nnsreg accel time, order(`o') method(`m') noplot
  4.         tempvar f
  5.         quietly predict double `f'
  6.         quietly gen double e2 = (accel-`f')^2
  7.         quietly summ e2, meanonly
  8.         di "order(`o') method(`m'): nknots=" `: word count `e(knots)'' "  
> rmse=" %6.3f sqrt(r(mean)) "  r2=" %5.3f e(r2)
  9.         drop e2
 10.     }
 11. }
