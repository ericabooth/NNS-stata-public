. // Segment diagnostic: the upper panel shows the fitted curve and knots.  The
. // lower panel shows the slope assigned to each x range, its conditional 95%
. // interval, and the number of observations in that range.  Thinly supported
. // ranges are dashed so the display prompts investigation rather than turning
. // every knot into a threshold claim.
. estimates restore moto_ols
(results moto_ols are active now)

. local klist "`e(knots)'"

. matrix S_moto = e(segments)

. local tcrit = invttail(e(df_r), .025)

. twoway ///
>     (scatter accel time, mcolor("108 122 141%45") msymbol(Oh) msize(small)) /
> //
>     (line fit_ols time, sort lcolor("27 45 85") lwidth(medthick)), ///
>     xline(`klist', lcolor("108 122 141") lpattern(shortdash) lwidth(vthin)) /
> //
>     ytitle("Acceleration (g)", size(small)) ///
>     xtitle("Time after impact (milliseconds)", size(small)) ///
>     ylabel(-150(50)100, labsize(small) angle(horizontal)) xlabel(0(20)60, lab
> size(small)) ///
>     legend(order(2 "NNS OLS fit, order(`ORD')") rows(1) size(small) position(
> 5) ///
>         region(lcolor(none))) ///
>     graphregion(color(white)) xsize(7) ysize(3.8) name(moto_curve, replace) n
> odraw

. 
. preserve

. clear

. svmat double S_moto, names(col)
number of observations will be reset to 14
Press any key to continue, or Break to abort
Number of observations (_N) was 0, now 14.

. gen double x_mid = (x_lo + x_hi) / 2

. gen double ci_lo = slope - `tcrit' * se

. gen double ci_hi = slope + `tcrit' * se

. gen byte sparse = n < 5

. gen byte label_slot = mod(_n, 4)

. gen str8 n_label = "n=" + string(n, "%2.0f")

. 
. twoway ///
>     (pcspike slope x_lo slope x_hi if !sparse, lcolor("27 45 85") lwidth(medt
> hick)) ///
>     (rcap ci_lo ci_hi x_mid if !sparse, lcolor("27 45 85") lwidth(vthin)) ///
>     (pcspike slope x_lo slope x_hi if sparse, lcolor(gs7) lpattern(shortdash)
>  lwidth(medthick)) ///
>     (rcap ci_lo ci_hi x_mid if sparse, lcolor(gs7) lpattern(shortdash) lwidth
> (vthin)) ///
>     (scatter slope x_mid if label_slot == 0, msymbol(O) msize(vsmall) mcolor(
> "27 45 85") ///
>         mlabel(n_label) mlabsize(vsmall) mlabposition(12) mlabcolor(gs5)) ///
>     (scatter slope x_mid if label_slot == 1, msymbol(O) msize(vsmall) mcolor(
> "27 45 85") ///
>         mlabel(n_label) mlabsize(vsmall) mlabposition(6) mlabcolor(gs5)) ///
>     (scatter slope x_mid if label_slot == 2, msymbol(O) msize(vsmall) mcolor(
> "27 45 85") ///
>         mlabel(n_label) mlabsize(vsmall) mlabposition(11) mlabcolor(gs5)) ///
>     (scatter slope x_mid if label_slot == 3, msymbol(O) msize(vsmall) mcolor(
> "27 45 85") ///
>         mlabel(n_label) mlabsize(vsmall) mlabposition(5) mlabcolor(gs5)), ///
>     yline(0, lcolor(gs8) lpattern(dot)) ///
>     ytitle("Slope (g per millisecond)", size(small)) ///
>     xtitle("Time after impact (milliseconds)", size(small)) ///
>     ylabel(-200(50)150, labsize(small) angle(horizontal)) ///
>     xlabel(0(20)60, labsize(small)) ///
>     legend(order(1 "Slope over range" 2 "95% conditional robust interval" ///
