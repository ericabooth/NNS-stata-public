. 
. // --------------------------------------------------------------------------
> -
. // Repeated k-fold cross-validation: held-out RMSE by method
. // --------------------------------------------------------------------------
> -
. di _n "=== Repeated `KFOLD'-fold CV, `CVREPS' repeats ==="

=== Repeated 5-fold CV, 20 repeats ===

. webuse motorcycle, clear
(Motorcycle data from Fan & Gijbels (1996))

. // Fixed restricted-cubic-spline basis at full-sample percentile knots.  This
. // comparator uses only the marginal distribution of time, but its basis is
. // fixed before the folds rather than recomputed inside each training fold.
. mkspline msp = time, cubic nknots(5)

. 
. tempname cv

. postfile `cv' str24 method double rmse int rep using "examples/moto_cv.dta", 
> replace

. 
. // The kernel estimator is scored at held-out time values through margins.
. // The series estimator uses predict, tolerance(100), which permits scoring
. // within the endpoint-bounded held-out set even when a training-fold spline
. // basis has a narrower internal support.
. local methods "linear mksp kernel series conn ols olsmed"

. local npfail = 0

. local seriesfail = 0

. 
. // The observations at the smallest and largest time are always kept in the
. // training set (fold 0), so every held-out point is interior to the training
. // range.  Thus each repeat scores 131 of the 133 observations.  Random folds
. // operate at the observation level, so tied time values can appear in both
. // training and validation data; the estimand is prediction for another
. // reading at a partly familiar time, not prediction at an unseen time value.
. quietly summarize time, meanonly

. local tmin = r(min)

. local tmax = r(max)

. 
. forvalues rep = 1/`CVREPS' {
  2.     set seed `=`CVSEED' + `rep''
  3.     quietly gen double u = runiform()
  4.     quietly xtile fold = u, nq(`KFOLD')
  5.     quietly replace fold = 0 if time == `tmin' | time == `tmax'
  6.     // One OOS prediction column per method
.     foreach m of local methods {
  7.         quietly gen double p_`m' = .
  8.     }
  9.     forvalues k = 1/`KFOLD' {
 10.         // ----- arms that predict out-of-sample directly -----
.         quietly regress accel time if fold != `k'
 11.         quietly predict double _tmp, xb
 12.         quietly replace p_linear = _tmp if fold == `k'
 13.         drop _tmp
 14. 
.         quietly regress accel msp* if fold != `k'
 15.         quietly predict double _tmp, xb
 16.         quietly replace p_mksp = _tmp if fold == `k'
 17.         drop _tmp
 18. 
.         capture quietly nnsreg accel time if fold != `k', order(`ORD') method
> (connect) noplot
 19.         if _rc == 0 {
 20.             quietly predict double _tmp
 21.             quietly replace p_conn = _tmp if fold == `k'
 22.             drop _tmp
 23.         }
 24.         capture quietly nnsreg accel time if fold != `k', order(`ORD') met
> hod(ols) noplot
 25.         if _rc == 0 {
 26.             quietly predict double _tmp
 27.             quietly replace p_ols = _tmp if fold == `k'
 28.             drop _tmp
 29.         }
 30.         capture quietly nnsreg accel time if fold != `k', order(`ORD') met
> hod(ols) noise(median) noplot
 31.         if _rc == 0 {
 32.             quietly predict double _tmp
 33.             quietly replace p_olsmed = _tmp if fold == `k'
 34.             drop _tmp
 35.         }
 36. 
.         // ----- npregress arms: held-out predictions via margins at() -----
.         levelsof time if fold == `k', local(hv)
 37.         capture {
 38.             quietly npregress kernel accel time if fold != `k'
 39.             quietly margins, at(time=(`hv')) predict(mean)
 40.             matrix P = r(b)
 41.             local i = 0
 42.             foreach v of local hv {
 43.                 local ++i
 44.                 quietly replace p_kernel = P[1, `i'] if fold == `k' & abs(
> time - `v') < 0.001
 45.             }
 46.         }
 47.         if _rc local ++npfail
 48. 
.         capture {
 49.             quietly npregress series accel time if fold != `k'
 50.             quietly predict double _tmp_series, mean tolerance(100)
 51.             quietly replace p_series = _tmp_series if fold == `k'
 52.             drop _tmp_series
 53.         }
 54.         if _rc local ++seriesfail
 55.     }
 56.     // One held-out RMSE per method for this repeat (over all N rows)
.     foreach m of local methods {
 57.         tempvar e2
 58.         quietly gen double `e2' = (accel - p_`m')^2
 59.         quietly summarize `e2', meanonly
 60.         post `cv' ("`m'") (sqrt(r(mean))) (`rep')
 61.         drop `e2' p_`m'
 62.     }
 63.     drop u fold
 64.     if mod(`rep', 5) == 0 di as text "  CV repeat `rep' of `CVREPS'"
 65. }
