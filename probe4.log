. forvalues k=1/5 {
  2.     levelsof time if fold==`k', local(hv)
  3.     di "--- fold `k' series ---"
  4.     quietly npregress series accel time if fold!=`k'
  5.     capture noisily margins, at(time=(`hv')) predict(mean)
  6.     di "  series margins rc=" _rc
  7.     di "--- fold `k' kernel ---"
  8.     quietly npregress kernel accel time if fold!=`k'
  9.     capture noisily margins, at(time=(`hv')) predict(mean)
 10.     di "  kernel margins rc=" _rc
 11. }
