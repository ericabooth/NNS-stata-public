. webuse motorcycle, clear
(Motorcycle data from Fan & Gijbels (1996))

. quietly summarize time, meanonly

. local tmin=r(min)

. local tmax=r(max)

. set seed 90211

. gen double u=runiform()

. xtile fold=u, nq(5)

. replace fold=0 if time==`tmin' | time==`tmax'
(0 real changes made)

. tab fold

