. do examples/robustness.do 

. *! version 1.0.0  18jul2026
. *! Two robustness checks for the nnsreg Stata Journal article, kept separate
. *! from the main replication script so that its outputs are unchanged:
. *!
. *!   1. Empirical coverage of the nominal-95% conditional interval for the
. *!      terminal-segment slope, across 100 replications per simulated design,
. *!      for method(ols) and method(connect).  The target is the true secant
. *!      slope of the generating curve over the fitted terminal segment.  Poor
. *!      coverage bounds the inferential use of these intervals and supports t
> he
. *!      "descriptive, not tests" reading.
. *!
. *!   2. An alternative clustered design (noise SD raised from 1.2 to 2.0) to
. *!      test whether the NNS OLS between-replication variance advantage
. *!      persists, and a percentile-knot linear spline (mkspline) arm to show
. *!      the adaptive-knot advantage on data with known truth.
. *!
. *! Writes manuscript/table_coverage.csv and manuscript/table_altclust.csv.
. clear all

. set more off

. adopath + "code"
  [1]  (BASE)      "/Applications/StataNow/ado/base/"
  [2]  (SITE)      "/_codeshare/"
  [3]              "."
  [4]  (PERSONAL)  "/Users/ericbooth/Documents/Stata/ado/personal/"
  [5]  (PLUS)      "/Users/ericbooth/Library/Application Support/Stata/ado/plus
> /"
  [6]  (OLDPLACE)  "~/ado/"
  [7]              "code"

. 
. // Defines nns_simdata (also rewrites the canonical datasets; harmless here).
. do "examples/simulated_data.do"

. *! version 1.3.0  05jul2026
. *! Simulated data generator for the nnsreg Stata Journal manuscript.
. *! Defines nns_simdata, a reusable data-generating program, and writes the
. *! three canonical example datasets to examples/.  The Monte Carlo study in
. *! examples/test_nnsreg.do calls nns_simdata with fresh seeds, so the single
. *! canonical datasets and the replication draws come from identical code.
. clear all

. 
. capture program drop nns_simdata

. program define nns_simdata
  1.     // Generates one simulated example dataset in memory (does not save).
.     // design(education|water|clustered) picks the data-generating process.
.     // seed(#) makes the draw reproducible; omit to continue the RNG stream.
.     syntax, DESign(string) [SEED(integer -1)]
  2. 
.     if !inlist("`design'", "education", "water", "clustered") {
  3.         di as error "design() must be education, water, or clustered"
  4.         exit 198
  5.     }
  6.     if `seed' >= 0 set seed `seed'
  7.     clear
  8. 
.     if "`design'" == "education" {
  9.         // Smooth S-curve with diminishing returns: flat at low spending,
.         // rising through the middle, plateauing near the top.
.         // True curve: 40 + 45 / (1 + exp(-0.8*(spend - 11))), noise sd = 4.
.         set obs 250
 10.         gen district_id = _n
 11.         gen spend_pupil = 5 + 15 * runiform()
 12.         gen true_staar = 40 + 45 / (1 + exp(-0.8 * (spend_pupil - 11)))
 13.         gen staar_pass = true_staar + rnormal(0, 4)
 14.         replace staar_pass = 100 if staar_pass > 100
 15.         replace staar_pass = 0 if staar_pass < 0
 16.         label variable spend_pupil "Per-Pupil Operational Spending ($ Thou
> sands)"
 17.         label variable staar_pass "STAAR Math Passing Rate (%)"
 18.         label variable true_staar "True passing-rate curve (simulation)"
 19.         label data "Texas School District Operational Funding and Achievem
> ent (Simulated)"
 20.     }
 21.     else if "`design'" == "water" {
 22.         // Threshold behavior: loss rate is flat below a pipe age of 35 ye
> ars,
.         // then rises with a linear plus quadratic term.  Noise sd = 2.5.
.         // The kink at age 35 is the "true change point" referenced in the
.         // manuscript's knot-location figure.
.         set obs 300
 23.         gen system_id = _n
 24.         gen pipe_age = 80 * runiform()
 25.         gen true_loss = 8 if pipe_age <= 35
 26.         replace true_loss = 8 + 0.4 * (pipe_age - 35) + 0.01 * (pipe_age -
>  35)^2 ///
>             if pipe_age > 35
 27.         gen water_loss = true_loss + rnormal(0, 2.5)
 28.         replace water_loss = 100 if water_loss > 100
 29.         replace water_loss = 0 if water_loss < 0
 30.         label variable pipe_age "Average Water Pipe Age (Years)"
 31.         label variable water_loss "Annual Water Loss Rate (%)"
 32.         label variable true_loss "True loss-rate curve (simulation)"
 33.         label data "Texas Municipal Water Infrastructure and Water Loss (S
> imulated)"
 34.     }
 35.     else {
 36.         // Clustered support with sharp local features: observations are
.         // concentrated in three regions (centers 22, 36, 58) holding a local
.         // peak, a sharp dip, and a partial recovery.  This design mirrors th
> e
.         // cluster benchmarks in Vinod and Viole (2018), where partition-base
> d
.         // fits are expected to have an advantage over a global bandwidth.
.         set obs 260
 37.         gen unit_id = _n
 38.         gen mix = runiform()
 39.         gen cluster_score = cond(mix < .45, rnormal(22, 3), ///
>             cond(mix < .75, rnormal(36, 2.2), rnormal(58, 4)))
 40.         replace cluster_score = max(5, min(70, cluster_score))
 41.         gen true_index = 18 + .18 * cluster_score ///
>             + 10 * exp(-((cluster_score - 24)^2) / 35) ///
>             - 16 * exp(-((cluster_score - 35)^2) / 18) ///
>             + 8 * exp(-((cluster_score - 58)^2) / 50)
 42.         gen outcome_index = true_index + rnormal(0, 1.2)
 43.         drop mix
 44.         label variable cluster_score "Clustered Index Score"
 45.         label variable outcome_index "Outcome Index"
 46.         label variable true_index "True outcome curve (simulation)"
 47.         label data "Clustered peak/dip benchmark data (Simulated)"
 48.     }
 49. end

. 
