  coverage replication 100 of 100

. postclose `cov'

. 
. use "examples/coverage_raw.dta", clear

. collapse (mean) coverage = covered (count) n = covered, by(design method)

. gen dnum = cond(design == "education", 1, cond(design == "water", 2, 3))

. sort dnum method

. format coverage %5.3f

. list design method coverage n, sepby(design) noobs

  +--------------------------------------+
  |    design    method   coverage     n |
  |--------------------------------------|
  | education   connect      0.800   100 |
  | education       ols      0.940   100 |
  |--------------------------------------|
  |     water   connect      0.990   100 |
  |     water       ols      0.940   100 |
  |--------------------------------------|
  | clustered   connect      0.990   100 |
  | clustered       ols      0.980   100 |
  +--------------------------------------+

. export delimited design method coverage n ///
>     using "manuscript/table_coverage.csv", replace
(file manuscript/table_coverage.csv not found)
file manuscript/table_coverage.csv saved

. 
. // --------------------------------------------------------------------------
> -
. // 2. Alternative clustered design (higher noise) + percentile-knot arm
. // --------------------------------------------------------------------------
> -
. di _n "=== Alternative clustered design: noise SD 2.0, 100 replications ==="

=== Alternative clustered design: noise SD 2.0, 100 replications ===

. tempname alt

. postfile `alt' str28 model double rmse_true int rep ///
>     using "examples/altclust_raw.dta", replace
(file examples/altclust_raw.dta not found)

. 
. capture program drop nns_rmse_true

. program define nns_rmse_true, rclass
  1.     syntax, Fitvar(name) Truevar(name)
  2.     tempvar e2
  3.     quietly gen double `e2' = (`truevar' - `fitvar')^2
  4.     quietly summarize `e2', meanonly
  5.     return scalar rmse = sqrt(r(mean))
  6. end

. 
. forvalues r = 1/100 {
  2.     clear
  3.     set seed `=30000 + `r''
  4.     set obs 260
  5.     gen mix = runiform()
  6.     gen cluster_score = cond(mix < .45, rnormal(22, 3), ///
>         cond(mix < .75, rnormal(36, 2.2), rnormal(58, 4)))
  7.     replace cluster_score = max(5, min(70, cluster_score))
  8.     gen true_index = 18 + .18 * cluster_score ///
>         + 10 * exp(-((cluster_score - 24)^2) / 35) ///
>         - 16 * exp(-((cluster_score - 35)^2) / 18) ///
>         + 8 * exp(-((cluster_score - 58)^2) / 50)
  9.     gen outcome_index = true_index + rnormal(0, 2.0)
 10.     drop mix
 11. 
.     quietly npregress kernel outcome_index cluster_score
 12.     quietly predict double f_k, mean
 13.     nns_rmse_true, fitvar(f_k) truevar(true_index)
 14.     post `alt' ("npregress kernel") (r(rmse)) (`r')
 15.     drop f_k
 16. 
.     quietly npregress series outcome_index cluster_score
 17.     quietly predict double f_s, mean
 18.     nns_rmse_true, fitvar(f_s) truevar(true_index)
 19.     post `alt' ("npregress series") (r(rmse)) (`r')
 20.     drop f_s
 21. 
.     quietly nnsreg outcome_index cluster_score, order(3) method(ols) noplot
 22.     quietly predict double f_o
 23.     nns_rmse_true, fitvar(f_o) truevar(true_index)
 24.     post `alt' ("NNS OLS, order(3)") (r(rmse)) (`r')
 25.     drop f_o
 26. 
.     // Percentile-knot linear spline (rank-placed knots), 6 pieces.
.     capture {
 27.         mkspline sp 6 = cluster_score, pctile
 28.         quietly regress outcome_index sp*
 29.         quietly predict double f_m, xb
 30.         nns_rmse_true, fitvar(f_m) truevar(true_index)
 31.         post `alt' ("Percentile-knot spline") (r(rmse)) (`r')
 32.         drop f_m sp*
 33.     }
 34.     if mod(`r', 25) == 0 di as text "  alt-clustered replication `r' of 10
> 0"
 35. }
