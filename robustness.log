. // True generating curve evaluated at an arbitrary x, by design.
. capture program drop nns_true_at

. program define nns_true_at, rclass
  1.     syntax, DESign(string) X(real)
  2.     if "`design'" == "education" {
  3.         return scalar y = 40 + 45 / (1 + exp(-0.8 * (`x' - 11)))
  4.     }
  5.     else if "`design'" == "water" {
  6.         if `x' <= 35 return scalar y = 8
  7.         else return scalar y = 8 + 0.4 * (`x' - 35) + 0.01 * (`x' - 35)^2
  8.     }
  9.     else {
 10.         return scalar y = 18 + 0.18 * `x' ///
>             + 10 * exp(-((`x' - 24)^2) / 35) ///
>             - 16 * exp(-((`x' - 35)^2) / 18) ///
>             + 8 * exp(-((`x' - 58)^2) / 50)
 11.     }
 12. end

. 
. // --------------------------------------------------------------------------
> -
. // 1. Coverage of the conditional terminal-segment interval
. // --------------------------------------------------------------------------
> -
. di _n "=== Coverage check: 100 replications per design ==="

=== Coverage check: 100 replications per design ===

. tempname cov

. postfile `cov' str12 design str8 method byte covered ///
>     using "examples/coverage_raw.dta", replace
(file examples/coverage_raw.dta not found)

. 
. forvalues r = 1/100 {
  2.     local dnum = 0
  3.     foreach d in education water clustered {
  4.         local ++dnum
  5.         if "`d'" == "education" {
  6.             local y staar_pass
  7.             local x spend_pupil
  8.         }
  9.         else if "`d'" == "water" {
 10.             local y water_loss
 11.             local x pipe_age
 12.         }
 13.         else {
 14.             local y outcome_index
 15.             local x cluster_score
 16.         }
 17.         nns_simdata, design(`d') seed(`=20000 + 3*(`r'-1) + `dnum'')
 18.         foreach m in ols connect {
 19.             capture {
 20.                 quietly nnsreg `y' `x', order(3) method(`m') noplot
 21.                 matrix S = e(segments)
 22.                 local ns = rowsof(S)
 23.                 local xlo = S[`ns', 1]
 24.                 local xhi = S[`ns', 2]
 25.                 local slope = S[`ns', 3]
 26.                 local se = S[`ns', 4]
 27.                 local tc = invttail(e(df_r), 0.025)
 28.                 local lo = `slope' - `tc' * `se'
 29.                 local hi = `slope' + `tc' * `se'
 30.                 nns_true_at, design(`d') x(`xlo')
 31.                 local ylo = r(y)
 32.                 nns_true_at, design(`d') x(`xhi')
 33.                 local yhi = r(y)
 34.                 local truesec = (`yhi' - `ylo') / (`xhi' - `xlo')
 35.                 local cvd = (`lo' <= `truesec') & (`truesec' <= `hi')
 36.                 post `cov' ("`d'") ("`m'") (`cvd')
 37.             }
 38.         }
 39.     }
 40.     if mod(`r', 25) == 0 di as text "  coverage replication `r' of 100"
 41. }
