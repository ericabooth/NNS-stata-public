. // --------------------------------------------------------------------------
> -
. // 5. Monte Carlo study: repeat the comparison across `MCREPS' fresh draws
. //    A single simulated dataset can flatter any method by luck of the draw.
. //    Here every design is redrawn `MCREPS' times (new x values and new
. //    noise), each method is refit, and RMSE against the known true curve is
. //    recorded.  Seeds are 10000 + 3*(rep-1) + design index, so every draw is
. //    reproducible.
. // --------------------------------------------------------------------------
> -
. di _n "=== Section 5: Monte Carlo study (`MCREPS' replications) ==="

=== Section 5: Monte Carlo study (100 replications) ===

. 
. tempname mc

. postfile `mc' str14 design int rep str8 mcode str24 model ///
>     double(r2 rmse_obs rmse_true) using "examples/mc_results.dta", replace

. 
. local np_failures = 0

. local series_failures = 0

. local nns_failures = 0

. timer clear 1

. timer on 1

. forvalues r = 1/`MCREPS' {
  2.     local dnum = 0
  3.     foreach d in education water clustered {
  4.         local ++dnum
  5.         if "`d'" == "education" {
  6.             local y staar_pass
  7.             local x spend_pupil
  8.             local t true_staar
  9.         }
 10.         else if "`d'" == "water" {
 11.             local y water_loss
 12.             local x pipe_age
 13.             local t true_loss
 14.         }
 15.         else {
 16.             local y outcome_index
 17.             local x cluster_score
 18.             local t true_index
 19.         }
 20. 
.         nns_simdata, design(`d') seed(`=10000 + 3*(`r'-1) + `dnum'')
 21. 
.         quietly regress `y' `x'
 22.         quietly predict double f_lin, xb
 23.         calc_metrics, fitvar(f_lin) yvar(`y') truevar(`t')
 24.         post `mc' ("`d'") (`r') ("linear") ("Linear regression") ///
>             (r(r2)) (r(rmse_obs)) (r(rmse_true))
 25. 
.         capture {
 26.             quietly npregress kernel `y' `x'
 27.             quietly predict double f_np, mean
 28.         }
 29.         if _rc == 0 {
 30.             calc_metrics, fitvar(f_np) yvar(`y') truevar(`t')
 31.             post `mc' ("`d'") (`r') ("kernel") ("npregress kernel") ///
>                 (r(r2)) (r(rmse_obs)) (r(rmse_true))
 32.         }
 33.         else {
 34.             local ++np_failures
 35.             post `mc' ("`d'") (`r') ("kernel") ("npregress kernel") (.) (.
> ) (.)
 36.         }
 37. 
.         capture {
 38.             quietly npregress series `y' `x'
 39.             quietly predict double f_series, mean
 40.         }
 41.         if _rc == 0 {
 42.             calc_metrics, fitvar(f_series) yvar(`y') truevar(`t')
 43.             post `mc' ("`d'") (`r') ("series") ("npregress series") ///
>                 (r(r2)) (r(rmse_obs)) (r(rmse_true))
 44.         }
 45.         else {
 46.             local ++series_failures
 47.             post `mc' ("`d'") (`r') ("series") ("npregress series") (.) (.
> ) (.)
 48.         }
 49. 
.         local i = 0
 50.         foreach spec in "order(3) method(connect)" "order(3) method(ols)" 
> ///
>             "order(4) method(ols)" {
 51.             local ++i
 52.             local mcode : word `i' of conn3 ols3 ols4
 53.             local mname : word `i' of "NNS connect, order(3)" ///
>                 "NNS OLS, order(3)" "NNS OLS, order(4)"
 54.             capture {
 55.                 quietly nnsreg `y' `x', `spec' partition(xy) ///
>                     noplot generate(f_nns`i')
 56.             }
 57.             if _rc == 0 {
 58.                 calc_metrics, fitvar(f_nns`i') yvar(`y') truevar(`t')
 59.                 post `mc' ("`d'") (`r') ("`mcode'") (`"`mname'"') ///
>                     (r(r2)) (r(rmse_obs)) (r(rmse_true))
 60.             }
 61.             else {
 62.                 local ++nns_failures
 63.                 post `mc' ("`d'") (`r') ("`mcode'") (`"`mname'"') (.) (.) 
> (.)
 64.                 di as error "  nnsreg failed: rep `r', design `d', `spec'"
 65.             }
 66.         }
 67.     }
 68.     if mod(`r', 10) == 0 di as text "  Monte Carlo replication `r' of `MCR
> EPS'"
 69. }
