. 
. tempname bench

. global BENCH `bench'

. postfile `bench' str24 scenario str32 model double r2 rmse_y rmse_true using 
> "work/benchmark_results.dta", replace

. 
. capture program drop _metrics

. program define _metrics
  1.     syntax, Scenario(string) Model(string) Fitvar(name) Truevar(name) Yvar
> (name)
  2.     tempvar resy rest tssy
  3.     quietly gen double `resy' = (`yvar' - `fitvar')^2
  4.     quietly gen double `rest' = (`truevar' - `fitvar')^2
  5.     quietly summarize `resy', meanonly
  6.     local rmse_y = sqrt(r(mean))
  7.     quietly summarize `rest', meanonly
  8.     local rmse_true = sqrt(r(mean))
  9.     quietly summarize `yvar', meanonly
 10.     local ybar = r(mean)
 11.     quietly gen double `tssy' = (`yvar' - `ybar')^2
 12.     quietly summarize `resy', meanonly
 13.     local rss = r(sum)
 14.     quietly summarize `tssy', meanonly
 15.     local tss = r(sum)
 16.     local r2 = 1 - (`rss' / `tss')
 17.     post $BENCH ("`scenario'") ("`model'") (`r2') (`rmse_y') (`rmse_true')
 18. end

. 
. capture program drop _run_models

. program define _run_models
  1.     syntax, Scenario(string) Xvar(name) Yvar(name) Truevar(name)
  2.     regress `yvar' `xvar'
  3.     predict double fit_linear, xb
  4.     _metrics, scenario("`scenario'") model("Linear regression") fitvar(fit
> _linear) truevar(`truevar') yvar(`yvar')
  5. 
.     quietly npregress kernel `yvar' `xvar'
  6.     predict double fit_np, mean
  7.     _metrics, scenario("`scenario'") model("npregress kernel") fitvar(fit_
> np) truevar(`truevar') yvar(`yvar')
  8. 
.     foreach p in xy xonly {
  9.         foreach o in 2 3 4 5 {
 10.             capture noisily nnsreg `yvar' `xvar', order(`o') method(connec
> t) partition(`p') noplot generate(fit_conn_`p'_`o')
 11.             if !_rc {
 12.                 _metrics, scenario("`scenario'") model("NNS connect `p' o`
> o'") fitvar(fit_conn_`p'_`o') truevar(`truevar') yvar(`yvar')
 13.             }
 14.             capture noisily nnsreg `yvar' `xvar', order(`o') method(ols) p
> artition(`p') noplot generate(fit_ols_`p'_`o')
 15.             if !_rc {
 16.                 _metrics, scenario("`scenario'") model("NNS OLS `p' o`o'")
>  fitvar(fit_ols_`p'_`o') truevar(`truevar') yvar(`yvar')
 17.             }
 18.         }
 19.     }
 20. end

. 
. // Smooth S-curve with moderate noise
. clear

. set obs 250
Number of observations (_N) was 0, now 250.

. gen x = 5 + 15 * runiform()

. gen true = 40 + 45 / (1 + exp(-0.8 * (x - 11)))

. gen y = true + rnormal(0, 4)

. _run_models, scenario("s_curve_noise") xvar(x) yvar(y) truevar(true)

