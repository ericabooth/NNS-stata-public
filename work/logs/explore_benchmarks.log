. 
. // High signal sine on a deterministic grid
. clear

. set obs 300
Number of observations (_N) was 0, now 300.

. gen x = 4 * _pi * (_n - 1) / (_N - 1)

. gen true = sin(x)

. gen y = true + rnormal(0, .04)

. _run_models, scenario("sine_grid_low_noise") xvar(x) yvar(y) truevar(true)

