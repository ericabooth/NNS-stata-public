. clear

. set obs 260
Number of observations (_N) was 0, now 260.

. gen mix = runiform()

. gen x = cond(mix < .45, rnormal(22, 3), cond(mix < .75, rnormal(36, 2.2), rno
> rmal(58, 4)))

. replace x = max(5, min(70, x))
(0 real changes made)

. gen true = 18 + .18*x + 10*exp(-((x-24)^2)/35) - 16*exp(-((x-35)^2)/18) + 8*e
> xp(-((x-58)^2)/50)

. gen y = true + rnormal(0, 1.2)

. _run_models, scenario("clustered_peak_dip") xvar(x) yvar(y) truevar(true)

