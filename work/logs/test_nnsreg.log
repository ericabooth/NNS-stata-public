. do "examples/simulated_data.do"

. *! version 1.0.0  02jul2026
. *! Simulated data generator for nnsreg Stata Journal manuscript
. clear all

. set seed 2036 // Texas 2036 seed for reproducibility

. 
. // 1. Simulate Texas Education Dataset (School Spending vs STAAR passing rate
> s)
. set obs 250
Number of observations (_N) was 0, now 250.

. gen district_id = _n

. 
. // Spend per pupil in thousands of dollars (range $5k to $20k)
. gen spend_pupil = 5 + 15 * runiform()

. 
. // STAAR passing rate: S-curve (inflection around $11k, plateauing around 85-
> 90%)
. gen true_staar = 40 + 45 / (1 + exp(-0.8 * (spend_pupil - 11)))

. gen staar_pass = true_staar + rnormal(0, 4)

. 
. // Clamp between 0 and 100
. replace staar_pass = 100 if staar_pass > 100
(0 real changes made)

. replace staar_pass = 0 if staar_pass < 0
(0 real changes made)

. 
. label variable spend_pupil "Per-Pupil Operational Spending ($ Thousands)"

. label variable staar_pass "STAAR Math Passing Rate (%)"

. label data "Texas School District Operational Funding and Achievement (Simula
> ted)"

. 
. save "examples/texas_education.dta", replace
file examples/texas_education.dta saved

. 
. // 2. Simulate Texas Water Infrastructure Dataset (Infrastructure Age vs Wate
> r Loss)
. clear

. set obs 300
Number of observations (_N) was 0, now 300.

. gen system_id = _n

. 
. // Average pipe age in years (range 0 to 80 years)
. gen pipe_age = 80 * runiform()

. 
. // Annual water loss rate in percent (stable below 35 years, spikes quadratic
> ally after)
. gen true_loss = 8 if pipe_age <= 35
(167 missing values generated)

. replace true_loss = 8 + 0.4 * (pipe_age - 35) + 0.01 * (pipe_age - 35)^2 if p
> ipe_age > 35
(167 real changes made)

. gen water_loss = true_loss + rnormal(0, 2.5)

. 
. // Clamp between 0 and 100
. replace water_loss = 100 if water_loss > 100
(0 real changes made)

. replace water_loss = 0 if water_loss < 0
(0 real changes made)

. 
. label variable pipe_age "Average Water Pipe Age (Years)"

. label variable water_loss "Annual Water Loss Rate (%)"

. label data "Texas Municipal Water Infrastructure and Water Loss (Simulated)"

. 
. save "examples/texas_water.dta", replace
file examples/texas_water.dta saved

. 
. // 3. Simulate clustered peak/dip data inspired by NNS segmentation examples
. clear

. set obs 260
Number of observations (_N) was 0, now 260.

. gen unit_id = _n

. gen mix = runiform()

. gen cluster_score = cond(mix < .45, rnormal(22, 3), ///
>     cond(mix < .75, rnormal(36, 2.2), rnormal(58, 4)))

. replace cluster_score = max(5, min(70, cluster_score))
(0 real changes made)

. 
. // Three dense regions with a local peak, sharp dip, and partial recovery.
. gen true_index = 18 + .18 * cluster_score ///
>     + 10 * exp(-((cluster_score - 24)^2) / 35) ///
>     - 16 * exp(-((cluster_score - 35)^2) / 18) ///
>     + 8 * exp(-((cluster_score - 58)^2) / 50)

. gen outcome_index = true_index + rnormal(0, 1.2)

. 
. label variable cluster_score "Clustered Index Score"

. label variable outcome_index "Outcome Index"

. label data "Clustered peak/dip benchmark data (Simulated)"

. 
. save "examples/clustered_peak_dip.dta", replace
file examples/clustered_peak_dip.dta saved

. 
. di "Data simulation complete. Files saved in examples/ subfolder."
Data simulation complete. Files saved in examples/ subfolder.

. 
end of do-file

