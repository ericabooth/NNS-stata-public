. capture program drop post_metrics

. program define post_metrics
  1.     syntax, Handle(name) Example(string) Model(string) ///
>         Fitvar(name) Yvar(name) Truevar(name)
  2. 
.     tempvar res_obs res_true tss
  3.     quietly gen double `res_obs' = (`yvar' - `fitvar')^2
  4.     quietly gen double `res_true' = (`truevar' - `fitvar')^2
  5.     quietly summarize `res_obs', meanonly
  6.     local rss = r(sum)
  7.     local rmse_obs = sqrt(r(mean))
  8.     quietly summarize `res_true', meanonly
  9.     local rmse_true = sqrt(r(mean))
 10.     quietly summarize `yvar', meanonly
 11.     local ybar = r(mean)
 12.     quietly gen double `tss' = (`yvar' - `ybar')^2
 13.     quietly summarize `tss', meanonly
 14.     local r2 = 1 - (`rss' / r(sum))
 15. 
.     post `handle' ("`example'") ("`model'") ///
>         (`r2') (`rmse_obs') (`rmse_true')
 16. end

. 
. tempname diag

. postfile `diag' str14 example str30 model double r2 rmse_obs rmse_true using 
> ///
>     "examples/model_diagnostics.dta", replace

. 
